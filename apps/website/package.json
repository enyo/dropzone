{
  "name": "@dropzone/website",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "imports": {
    "#lib": "./src/lib",
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --threshold warning",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "playwright test"
  },
  "devDependencies": {
    "@fontsource/heebo": "^5.2.11",
    "@iconify-json/ion": "^1.2.7",
    "@sveltejs/adapter-static": "4.0.0-next.4",
    "@sveltejs/kit": "3.0.0-next.27",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/dropzone": "^5.7.9",
    "dropzone": "workspace:*",
    "postcss": "^8.5.6",
    "postcss-functions": "^4.0.2",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "unplugin-icons": "^24.0.0",
    "vite": "^8.3.1"
  }
}
